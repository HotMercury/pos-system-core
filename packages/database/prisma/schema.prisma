datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum OrderStatus {
  CREATED
  PAID
  PREPARING
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  UNPAID
  PAID
}

enum ProductSize {
  M
  L
}

enum ProductTemperature {
  H
  I
}

enum OrderType {
  DINE_IN
  TAKEAWAY
}

enum PromotionDiscountType {
  PERCENTAGE
  FIXED
}

enum CustomerSegment {
  GENERAL
  MEDICAL
}

model Table {
  id        String   @id @default(uuid())
  number    String   @unique
  orders    Order[]
  createdAt DateTime @default(now())
}

model Product {
  id            String           @id @default(uuid())
  name          String
  englishName   String?
  description   String?
  price         Int              @default(0)
  category      String
  categoryOrder Int              @default(0)
  displayOrder  Int              @default(0)
  imageUrl      String?
  isAvailable   Boolean          @default(true)
  variants      ProductVariant[]
  orderItems    OrderItem[]
}

model ProductVariant {
  id          String             @id @default(uuid())
  productId   String
  product     Product            @relation(fields: [productId], references: [id])
  size        ProductSize
  temperature ProductTemperature
  flavor      String             @default("")
  price       Int
  isAvailable Boolean            @default(true)
  orderItems  OrderItem[]

  @@unique([productId, size, temperature, flavor])
}

model Order {
  id            String      @id @default(uuid())
  orderType     OrderType   @default(DINE_IN)
  tableId       String?
  table         Table?      @relation(fields: [tableId], references: [id])
  pickupCode    String?     @unique
  publicToken   String?     @unique
  promotionId   String?
  promotion     Promotion?  @relation(fields: [promotionId], references: [id])
  promotionCode String?
  customerSegment CustomerSegment @default(GENERAL)
  subtotalAmount Int
  discountAmount Int          @default(0)
  totalAmount   Int
  status        OrderStatus @default(CREATED)
  paymentStatus PaymentStatus @default(UNPAID)
  paymentMethod String?
  ecpayTradeNo  String?
  items         OrderItem[]
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

model Promotion {
  id             String                 @id @default(uuid())
  code           String                 @unique
  discountType   PromotionDiscountType
  value          Int
  isActive       Boolean                @default(true)
  startsAt       DateTime?
  endsAt         DateTime?
  minAmount      Int                    @default(0)
  maxUses        Int?
  usedCount      Int                    @default(0)
  isMedical      Boolean                @default(false)
  orders         Order[]
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
}

model OrderItem {
  id         String   @id @default(uuid())
  orderId    String
  order      Order    @relation(fields: [orderId], references: [id])
  productId  String
  product    Product  @relation(fields: [productId], references: [id])
  variantId  String?
  variant    ProductVariant? @relation(fields: [variantId], references: [id])
  variantSize String?
  variantTemperature String?
  variantFlavor String?
  quantity   Int
  price      Int
  options    String?
}
